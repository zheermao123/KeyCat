{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "build",
  "instructions": [
    "governance/SINGLE_SOURCE_OF_TRUTH.md",
    "governance/TASK_HANDOFF_PROTOCOL.md",
    "governance/INDEPENDENT_ACCEPTANCE.md"
  ],
  "agents": {
    "build": {
      "mode": "primary",
      "description": "Primary project coordinator and implementation agent. Must follow repository governance.",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "allow" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "shell", "resource": "git branch --show-current", "effect": "allow" }
      ]
    }
  }
}
